{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "helpers:pinGitHubActionDigests",
    "schedule:earlyMondays",
    ":maintainLockFilesMonthly",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "labels": ["dependencies"],
  "cargo": {
    "enabled": true
  },
  "rangeStrategy": "bump",
  "automerge": true,
  "platformAutomerge": false,
  "platformCommit": true,
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": null
    }
  ]
}
